{{- /*
  خريطة الموقع — تستبعد ما نمنع فهرسته.

  ‏Hugo يدرج كل صفحة افتراضيًّا، فكانت 9 صفحات تحمل `noindex` مدرجة في
  الخريطة: نقول للزاحف «تعال» و«لا تفهرس» في آنٍ واحد. ذلك يستهلك
  ميزانية زحف على صفحات لن تُفهرَس، وترصده كل أدوات فحص المواقع تناقضًا.

  الشرط هنا **نظير** شرط `$emptySection` في partials/head.html: تصنيف
  بلا مقالات. ولو تغيّر أحدهما وحده عاد التناقض — فهما يُقرآن معًا.
*/ -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{- range .Data.Pages }}
    {{- $empty := and (or .IsHome (eq .Kind "section") (eq .Kind "term")) (eq (len .RegularPagesRecursive) 0) -}}
    {{- if and .Permalink (not $empty) }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if not .Lastmod.IsZero }}
    <lastmod>{{ safeHTML (.Lastmod.Format "2006-01-02T15:04:05-07:00") }}</lastmod>
    {{- end }}
    {{- with .Sitemap.ChangeFreq }}
    <changefreq>{{ . }}</changefreq>
    {{- end }}
    {{- if ge .Sitemap.Priority 0.0 }}
    <priority>{{ .Sitemap.Priority }}</priority>
    {{- end }}
    {{- range .AllTranslations }}
    <xhtml:link rel="alternate" hreflang="{{ .Lang }}" href="{{ .Permalink }}"/>
    {{- end }}
  </url>
    {{- end }}
  {{- end }}
</urlset>
